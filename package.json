{
  "name": "airtable-fullstack-mcp",
  "version": "1.1.1",
  "description": "The world's first dual-engine Airtable MCP server: unified REST & Metadata APIs, real-time Webhooks, In-Base Automation Scripting, full Record CRUD, and Chrome CDP Interface Designer automation (Dashboards, Kanbans, Column Edit Locks, and Publishing).",
  "main": "dist/index.js",
  "bin": {
    "airtable-fullstack-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx tests/e2e.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "airtable",
    "mcp",
    "model-context-protocol",
    "claude",
    "interface-designer",
    "playwright",
    "cdp",
    "automation"
  ],
  "author": "Praroop Anand",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "playwright-core": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ]
